
manifest {
    name            = 'oucru-id/tb-to-fhir-full'
    description     = 'Mycobacterium tuberculosis WGS to WHO-catalogue drug resistance, lineage and HL7 FHIR Genomics reports'
    homePage        = 'https://github.com/oucru-id/tb-to-fhir-full'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.04.0'
    version         = '2.0.0'
    license         = 'MIT'
}

plugins {
    id 'nf-schema@2.5.1'
}

params {
    input       = null      // samplesheet: sample,platform,fastq_1,fastq_2,vcf
    reads_dir   = null      // legacy: <id>_{1,2}_illumina.fastq.gz, <id>_ont.fastq.gz
    vcf_dir     = null      // legacy: <id>.vcf(.gz)
    outdir      = 'results'
    results_dir = null      

    reference               = "${projectDir}/data/H37Rv.fasta"
    annotation_table        = "${projectDir}/data/2026-09-07_annotation_table.tsv.gz"
    annotation_header       = "${projectDir}/data/2026-09-07_annotations_header.txt"
    lineage_barcode         = "${projectDir}/data/2026-05-11_lineage.bed"
    repetitive_regions      = "${projectDir}/data/repetitive_regions.bed"
    gene_map                = "${projectDir}/data/gene_ncbi_map.tsv"
    legacy_annotation_table = false

    trimmomatic_jar   = null   
    nanopore_min_q    = 10
    nanopore_min_l    = 500
    medaka_model      = null   // required for ONT input
    medaka_batch_size = 100

    filter_min_depth     = 5
    filter_min_quality   = 20
    coverage_min_depth   = 10
    coverage_min_breadth = 0.95
    promoter_padding     = 200

    // FHIR output ------------------------------------------------------------
    fhir_profile           = 'generic'   // generic | satusehat
    performer_org_id       = null        // FHIR id of the performing laboratory (not PHI)
    performer_org_name     = null
    identifier_system_base = null       
    patient_metadata      = null
    organization_metadata = null
    practitioner_metadata = null
    external_refs         = null         
    require_clinical      = false
    bundle_request_method = 'PUT'        // PUT | POST
    publish_clinical      = true

    // FHIR validation --------------------------------------------------------
    skip_fhir_validation       = false
    fhir_validator             = 'https://github.com/hapifhir/org.hl7.fhir.core/releases/download/6.5.26/validator_cli.jar'
    fhir_ig                    = 'hl7.fhir.uv.genomics-reporting#3.0.0'
    fhir_tx_server             = 'n/a'  
    fail_on_validation_error   = null
    fhir_validation_batch_size = 50

    fhir_server_url     = null
    fhir_auth_url       = null
    fhir_upload_api_key = false

    max_cpus   = Math.min(8, Runtime.runtime.availableProcessors())
    max_memory = '16 GB'
    max_time   = '24h'

    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    test_stub {
        includeConfig 'conf/test_stub.config'
    }
    test_vcf {
        includeConfig 'conf/test_vcf.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        conda.enabled       = false
        singularity.enabled = false
        apptainer.enabled   = false
        podman.enabled      = false
    }
    podman {
        podman.enabled      = true
        conda.enabled       = false
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        apptainer.enabled      = false
        podman.enabled         = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        conda.enabled        = false
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
    }
    conda {
        conda.enabled       = true
        conda.channels      = ['conda-forge', 'bioconda']
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
        podman.enabled      = false
    }
    mamba {
        conda.enabled       = true
        conda.useMamba      = true
        conda.channels      = ['conda-forge', 'bioconda']
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
        podman.enabled      = false
    }
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
