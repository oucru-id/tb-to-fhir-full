
process {
    publishDir = [enabled: false]

    withName: 'FASTQC' {
        publishDir = [path: { "${params.outdir}/qc/fastqc" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'NANOPLOT' {
        publishDir = [path: { "${params.outdir}/qc/nanoplot" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'MULTIQC' {
        publishDir = [path: { "${params.outdir}/qc/multiqc" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'MAKE_WHO_TARGETS|MOSDEPTH|SUMMARIZE_COVERAGE|COVERAGE_NOT_ASSESSED' {
        publishDir = [path: { "${params.outdir}/qc/coverage" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'FILTER_VARIANTS|ANNOTATE_VARIANTS' {
        publishDir = [path: { "${params.outdir}/variants" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'CLASSIFY_LINEAGE' {
        publishDir = [path: { "${params.outdir}/lineage" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'SAMPLE_REPORT' {
        publishDir = [path: { "${params.outdir}/reports" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'FHIR_GENOMIC' {
        publishDir = [path: { "${params.outdir}/fhir/genomic" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'FHIR_CLINICAL' {
        publishDir = [path: { "${params.outdir}/fhir" }, mode: 'copy', pattern: 'clinical',
                      enabled: params.publish_clinical.toString().toBoolean()]
    }
    withName: 'FHIR_LINK' {
        publishDir = [path: { "${params.outdir}/fhir" }, mode: 'copy', pattern: 'bundle/*']
    }
    withName: 'FHIR_VALIDATE' {
        publishDir = [path: { "${params.outdir}/fhir/validation" }, mode: 'copy', pattern: 'validation.json',
                      saveAs: { _fn -> "validation_${task.index}.json" }]
    }
    withName: 'FHIR_UPLOAD|FHIR_UPLOAD_WITH_API_KEY' {
        publishDir = [path: { "${params.outdir}/fhir/upload" }, mode: 'copy', saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
}
